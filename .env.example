# Wyoming
WYOMING_HOST=0.0.0.0
WYOMING_PORT=10200
WYOMING_AUDIO_CHUNK_MS=20

# Chatterbox
CHATTERBOX_VARIANT=multilingual
# CHATTERBOX_VARIANTS=standard,multilingual
CHATTERBOX_DEVICE=auto
CHATTERBOX_PRELOAD=true
CHATTERBOX_MODEL=
CHATTERBOX_CACHE_DIR=/models
CHATTERBOX_VOICES_DIR=/voices
CHATTERBOX_DEFAULT_VOICE=
CHATTERBOX_DEFAULT_LANGUAGE=en

# Streaming
CHATTERBOX_STREAMING_MODE=segmented
CHATTERBOX_SEGMENT_MIN_CHARS=40
CHATTERBOX_SEGMENT_TARGET_CHARS=160
CHATTERBOX_SEGMENT_MAX_CHARS=280
CHATTERBOX_SEGMENT_FLUSH_MS=250
CHATTERBOX_PREFETCH_SEGMENTS=2
CHATTERBOX_SYNTHESIS_WORKERS=1
CHATTERBOX_SYNTHESIS_CONCURRENCY=2

# Generation
CHATTERBOX_EXAGGERATION=0.5
CHATTERBOX_CFG_WEIGHT=0.5
CHATTERBOX_TEMPERATURE=0.8
CHATTERBOX_TOP_P=1.0
CHATTERBOX_MIN_P=0.05
CHATTERBOX_TOP_K=1000
CHATTERBOX_REPETITION_PENALTY=1.2
# CHATTERBOX_SEED=1234

# Audio boundary
CHATTERBOX_PERIOD_PAUSE_MS=120
CHATTERBOX_COMMA_PAUSE_MS=50
CHATTERBOX_CROSSFADE_MS=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text
HF_TOKEN=
